# Secrets and connection strings for the production AI container.
#
# Install as /opt/kada/ai/ai.env with mode 600:
#   cp deploy/ai.env.example /opt/kada/ai/ai.env && chmod 600 /opt/kada/ai/ai.env
#
# deploy/deploy-ai.sh refuses to deploy while this file is missing: the service
# would start happily and then fail every single chat request on the provider
# side, which is far harder to diagnose than a refused deploy.
#
# Nothing here may be committed - the repository only carries this example.

# PostgreSQL holding the conversations (truth source) and the pgvector
# knowledge base. The database and the vector extension are prepared by
# deploy/setup-ai-db.sh; note that this points at kada_ai, not at the Go
# business database.
POSTGRES_URL=postgresql+asyncpg://kada:CHANGE_ME@127.0.0.1:5432/kada_ai

# Session hot cache. Optional: an unreachable Redis only costs a database read.
REDIS_URL=redis://127.0.0.1:6379/0

# The Go API on this host, called by the MCP tools (link statistics, creating
# short links).
KADA_API_BASE=http://127.0.0.1:8080

# Chat model (DeepSeek, OpenAI-compatible API).
DEEPSEEK_API_KEY=

# Embeddings for RAG. The variable name is literally "aliyun" (Alibaba Cloud
# Bailian / DashScope) - not DASHSCOPE_API_KEY. See backend/ai/app/config.py.
aliyun=

# Shared secret with the Go gateway: the gateway injects it as X-Internal-Secret,
# and this service then accepts only requests that came through the gateway -
# which is what makes the X-Kada-User-ID header it also sends trustworthy.
# Generate with: openssl rand -hex 32
# Put the same value in backend/.env (or the backend container environment).
# Empty disables the check: local development only.
AI_INTERNAL_SECRET=

# There is deliberately no long-lived API token here any more: the tools that
# read link statistics or create short links act as the signed-in user, using
# the JWT that the Go gateway already forwards on every chat request.
