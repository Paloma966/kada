# ========== Database ==========
DATABASE_URL=postgres://kada:kada123@localhost:5432/kada?sslmode=disable
# Let this process apply the schema on startup (GORM AutoMigrate, models in internal/domain/entity).
# Set to false when the schema is applied out of band by cmd/migrate, as in production.
DB_AUTO_MIGRATE=true

# ========== Redis ==========
REDIS_URL=redis://localhost:6379

# ========== JWT ==========
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=720h  # 30 days

# ========== SMS (Alibaba Cloud) ==========
# Phone number + SMS code is the ONLY way to sign in, so these four values are not optional in
# production: without them nobody can log in. Empty values still let the process start, and codes are
# then printed to the log outside release mode (development only).
#
# SMS_SIGN_NAME and SMS_TEMPLATE_CODE are the system-granted signature and template that the Aliyun PNVS
# ("SMS verification") console issues per account. They cannot be guessed, invented, or copied from an
# example: a wrong pair is rejected by the provider, which looks exactly like a broken account.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ========== Server ==========
PORT=8080
GIN_MODE=debug
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ========== Kafka (click event stream) ==========
# Comma-separated brokers; empty = Kafka disabled and clicks are written straight to the database.
# Use 29092 from the host (see the EXTERNAL listener in docker-compose.yml)
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=clicks

# ========== AI service gateway ==========
# Internal Python AI service that /api/ai/* is proxied to. Never expose it publicly.
AI_BASE_URL=http://127.0.0.1:8000
# Shared secret injected as X-Internal-Secret so the AI service accepts only requests that came
# through this gateway (which is what makes its X-Kada-User-ID header trustworthy).
# Generate with: openssl rand -hex 32 - and set the same value in the AI service environment
# (/opt/kada/ai/ai.env). Empty disables the check on both sides: local development only.
AI_INTERNAL_SECRET=
