# ========== Database ==========
DATABASE_URL=postgres://kada:kada123@localhost:5432/kada?sslmode=disable
# Let this process apply the schema on startup (GORM AutoMigrate, models in internal/domain/entity).
# Set to false when the schema is applied out of band by cmd/migrate, as in production.
DB_AUTO_MIGRATE=true

# ========== Redis ==========
REDIS_URL=redis://localhost:6379

# ========== JWT ==========
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=720h  # 30 days

# ========== SMS (Alibaba Cloud) ==========
# Phone number + SMS code is the ONLY way to sign in, so these four values are not optional in
# production: without them nobody can log in. Empty values still let the process start, and codes are
# then printed to the log outside release mode (development only).
#
# SMS_SIGN_NAME and SMS_TEMPLATE_CODE are the system-granted signature and template that the Aliyun PNVS
# ("SMS verification") console issues per account. They cannot be guessed, invented, or copied from an
# example: a wrong pair is rejected by the provider, which looks exactly like a broken account.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ========== Server ==========
PORT=8080
GIN_MODE=debug
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ========== Kafka (click event stream) ==========
# Comma-separated brokers; empty = Kafka disabled and clicks are written straight to the database.
# Use 29092 from the host (see the EXTERNAL listener in docker-compose.yml)
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=clicks

# ========== AI assistant ==========
# The assistant runs inside this process: /api/ai/* is served by this binary, and there is no second
# service to configure, no internal secret and no second database.
#
# Empty values still let the process start, and the failure is confined to the AI page: without the chat
# key every question answers with a configuration message, and without the embedding key the assistant
# answers from the model alone, with no retrieved context.
DEEPSEEK_API_KEY=
# DashScope (Alibaba Cloud Bailian) embedding API key, for the knowledge base. Run
# `go run ./cmd/ai-ingest/` after changing the corpus or this model.
DASHSCOPE_API_KEY=

# Optional: the chat model, its endpoint, the answer budget, and the embedding model. The defaults are
# what the assistant ran with before, including the model name.
# AI_CHAT_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_MAX_TOKENS=8192
# AI_EMBEDDING_MODEL=text-embedding-v3
