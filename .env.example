# Kada environment variables: copy to .env, fill in real values, then run `docker compose up -d`
#
# Generate a strong random JWT secret: openssl rand -hex 32
JWT_SECRET=
#
# Database password (must be changed in production, do not use kada123)
POSTGRES_PASSWORD=
#
# Let the API container apply the database schema on startup with GORM AutoMigrate.
# The schema is defined by backend/internal/domain/entity; AutoMigrate only adds missing
# tables/columns/indexes, never drops them.
DB_AUTO_MIGRATE=true
#
# Alibaba Cloud SMS.
#
# Phone number + SMS code is the only way to sign in, so in production these four are what makes the site
# usable at all: without them it is up and nobody can log in. Leave them empty for a local setup only -
# real sending is then disabled and verification codes are printed to the API log outside release mode.
# Copying the placeholder text from an example file is worse than leaving them empty, because the API
# starts and then fails on every sign-in.
#
# The deploy job writes them from repository secrets and refuses to deploy while any of them is empty, so a
# host without them is a refused deploy rather than a site that is up and unusable. That check reads the
# file, not the secrets, so a value already configured here by hand counts as configured.
#
# Both the signature (SMS_SIGN_NAME) and the template (SMS_TEMPLATE_CODE) are the system-granted pair
# from the Aliyun PNVS ("SMS verification") console. Neither has a default: they cannot be guessed or
# invented, and a wrong pair is rejected by the provider in a way that looks like a broken account.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
#
# AI service (Python, backend/ai). Empty values still let the stack start; AI
# features simply stay disabled until the keys are provided.
# DeepSeek chat model API key
DEEPSEEK_API_KEY=
# DashScope (Alibaba Cloud Bailian) embedding API key. The variable name is literally "aliyun".
aliyun=
# No AI service token: the tools that read link statistics or create short links
# act as the signed-in user, with the JWT the gateway forwards on each request.
#
# Shared secret between the Go gateway and the AI service: the gateway injects it as
# X-Internal-Secret, so the AI service accepts only requests that came through the gateway.
# Generate with: openssl rand -hex 32
AI_INTERNAL_SECRET=
#
# On a production host the AI service runs as a container of its own and reads
# these values (plus POSTGRES_URL/REDIS_URL/KADA_API_BASE/AI_INTERNAL_SECRET) from
# /opt/kada/ai/ai.env instead of this file: see deploy/ai.env.example and the
# deployment section of backend/ai/README.md.
#
# There, none of the secrets above are typed in by hand. The deploy job writes them from GitHub
# repository secrets with deploy/upsert-env.sh, as its first step and before any service is replaced. All of
# them are required: a missing one fails the deployment while the previous build keeps serving, and names
# the key. The check reads the host's env files rather than the secrets, so a value configured there by
# hand also satisfies it.
