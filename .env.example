# Kada environment variables: copy to .env, fill in real values, then run `docker compose up -d`
#
# Generate a strong random JWT secret: openssl rand -hex 32
JWT_SECRET=
#
# Database password (must be changed in production, do not use kada123)
POSTGRES_PASSWORD=
#
# Let the API container apply the database schema on startup with GORM AutoMigrate.
# The schema is defined by backend/internal/domain/entity; AutoMigrate only adds missing
# tables/columns/indexes, never drops them.
DB_AUTO_MIGRATE=true
#
# Alibaba Cloud SMS. Leave the credentials empty to disable real sending: verification codes are then
# only printed to the API log outside release mode. Copying the placeholder text from an example file
# is worse than leaving them empty, because the API starts and then fails on every sign-up.
# Both the signature (SMS_SIGN_NAME) and the template (SMS_TEMPLATE_CODE) must be approved in the
# Alibaba Cloud console before they can be used.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
#
# AI service (Python, backend/ai). Empty values still let the stack start; AI
# features simply stay disabled until the keys are provided.
# DeepSeek chat model API key
DEEPSEEK_API_KEY=
# DashScope (Alibaba Cloud Bailian) embedding API key. The variable name is literally "aliyun".
aliyun=
# No AI service token: the tools that read link statistics or create short links
# act as the signed-in user, with the JWT the gateway forwards on each request.
#
# Shared secret between the Go gateway and the AI service: the gateway injects it as
# X-Internal-Secret, so the AI service accepts only requests that came through the gateway.
# Generate with: openssl rand -hex 32
AI_INTERNAL_SECRET=
#
# On a production host the AI service runs as a container of its own and reads
# these values (plus POSTGRES_URL/REDIS_URL/KADA_API_BASE/AI_INTERNAL_SECRET) from
# /opt/kada/ai/ai.env instead of this file: see deploy/ai.env.example and the
# deployment section of backend/ai/README.md.
